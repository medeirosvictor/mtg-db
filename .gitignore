# Wails build output
build/bin

# Frontend dependencies (regenerated with pnpm install)
frontend/node_modules

# Frontend build output (regenerated with pnpm build)
frontend/dist

# Wails generated JS bindings (regenerated on wails dev/build)
frontend/wailsjs

# App data (generated at build/runtime in %APPDATA%/mtg-db)
# - config.json (collection paths)
# - cards.db (SQLite cache)
# - images/cache/ (Scryfall images)
# - images/mpc/ (MPC Autofill images)
# These are all rebuildable and should not be committed
